{
  "name": "sentinel.ai-v15",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "dist/electron/main.cjs",
  "homepage": "./",
  "scripts": {
    "predev:electron": "node -e \"const fs=require('fs'); for (const p of ['node_modules/.vite','.vite']) { try { fs.rmSync(p,{recursive:true,force:true}); } catch {} }\"",
    "dev": "vite",
    "dev:api": "npx tsx server.js",
    "dev:api:modular": "npx tsx server/index.ts",
    "dev:electron:main": "node build-electron.js && set ELECTRON_RUN_AS_NODE=&& electron .",
    "dev:electron": "npm-run-all --parallel dev dev:electron:main",
    "start": "npx tsx server.js",
    "start:modular": "npx tsx server/index.ts",
    "start:all": "npm-run-all --parallel start dev",
    "build": "node build-electron.js && vite build && electron-builder --config electron-builder.config.js",
    "build:vite": "vite build",
    "build:electron": "node build-electron.js",
    "build:dist": "electron-builder --config electron-builder.config.js",
    "download:ffmpeg": "node download-ffmpeg.js",
    "download:python": "node download-python.js",
    "install:all": "node install-all.js",
    "install:paddleocr": "node -e \"const {execSync} = require('child_process'); const pythonPath = './resources/python/python.exe'; execSync(`${pythonPath} -m pip install paddleocr paddlepaddle pillow`, {stdio: 'inherit'})\"",
    "test:electron": "node test-electron.js",
    "preview": "vite preview",
    "electron": "npm run dev:electron",
    "test": "vitest",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@google/genai": "^1.0.0",
    "@mediapipe/tasks-vision": "^0.10.22-rc.20250304",
    "@supabase/supabase-js": "^2.104.1",
    "@tensorflow-models/coco-ssd": "^2.2.3",
    "@tensorflow/tfjs": "^4.22.0",
    "cors": "^2.8.6",
    "electron-updater": "^6.8.3",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "fluent-ffmpeg": "^2.1.3",
    "h265web.js": "^2.2.2",
    "jspdf": "^4.0.0",
    "lucide-react": "^0.460.0",
    "multer": "^2.1.1",
    "onnxruntime-web": "^1.24.3",
    "pdf-lib": "^1.17.1",
    "pg": "^8.20.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "sharp": "^0.34.5",
    "worker-loader": "^3.0.8",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/ui": "^4.0.17",
    "autoprefixer": "^10.4.23",
    "electron": "^28.0.0",
    "electron-builder": "^24.11.1",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^17.4.0",
    "jsdom": "^27.4.0",
    "npm-run-all2": "^8.0.4",
    "postcss": "^8.5.6",
    "prettier": "^3.8.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.58.1",
    "vite": "^6.2.0",
    "vitest": "^4.0.17"
  }
}
