# ─── Sentinel AI — Environment Variables ────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.

# ── AI ────────────────────────────────────────────────────────────────────────
# Google Gemini API key (required for AI geometry and forensic audit)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model to use (default shown)
GEMINI_MODEL=gemini-2.5-flash

# ── Server ────────────────────────────────────────────────────────────────────
# Express server port
PORT=3002

# Bearer token required for API access from non-loopback clients
# Generate a strong random value: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SENTINEL_API_TOKEN=

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (default: localhost only)
ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# ── Reports ──────────────────────────────────────────────────────────────────
# Directory where PDF reports and video evidence are saved
REPORTS_DIR=C:\Denuncias

# Maximum size per PDF report (MB)
REPORT_MAX_MB=100

# ── Transcoding ───────────────────────────────────────────────────────────────
# Maximum concurrent video transcodes
TRANSCODE_MAX_CONCURRENCY=2

# Maximum bytes for a single transcode job (default 250 MB)
TRANSCODE_MAX_BYTES=262144000

# ── Rate limiting ────────────────────────────────────────────────────────────
# Window in milliseconds
API_RATE_LIMIT_WINDOW_MS=60000

# Max requests per window per IP
API_RATE_LIMIT_MAX_REQUESTS=120

# ── IP Camera ────────────────────────────────────────────────────────────────
# Comma-separated explicit allowlist of camera hostnames/IPs.
# If empty, all non-private DNS-resolvable hosts are allowed.
IP_CAMERA_ALLOWED_HOSTS=
